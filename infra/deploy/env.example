# Copy next to this file as .env for the compose deployment (never commit the filled copy).
# Node the naming: the deploy stack reads these in addition to the application variables.

# --- required to start anything -------------------------------------------------
TRANSACTRA_DATABASE_PASSWORD=
# Control-plane credentials. Generate each with: openssl rand -hex 32
# They must be different values and at least 32 characters each.
CONTROL_PLANE_API_TOKEN=
CONTROL_PLANE_APPROVAL_TOKEN=
# The owner UUID printed by db:bootstrap-owner. Required by every service.
TRANSACTRA_OWNER_ID=

# --- Telegram channel (the only channel that needs no public port) ---------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- optional per feature; each missing one fails closed, never faked ------------
# Zero-cost NVIDIA NIM inference. All five required together or none.
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_FREE_TIER_VERIFIED_AT=
NVIDIA_NIM_MONTHLY_REQUEST_CAP=
NVIDIA_NIM_MONTHLY_TOKEN_CAP=

# Free-plan Tavily web research.
TAVILY_API_KEY=
TAVILY_PAYG_DISABLED_CONFIRMED=false

# GitHub App for the engineering, deployment and self-evolution paths.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPOSITORY_ALLOWLIST=
GITHUB_REPOSITORY_CREATE_TOKEN=

# Isolated sandbox. Build with infra/deploy/sandbox-image.Dockerfile and pin the printed digest.
TRANSACTRA_SANDBOX_IMAGE=
# Host path of the Docker socket the worker may reach (default /var/run/docker.sock).
TRANSACTRA_DOCKER_SOCKET=/var/run/docker.sock

# --- optional tuning ------------------------------------------------------------
TRANSACTRA_WORKER_ID=transactra-worker-1
TRANSACTRA_CYCLE_INTERVAL_MS=900000
TRANSACTRA_EVOLUTION_REPOSITORY=KUNDURUHIMANEESHREDDY/transactra
MONTHLY_SPEND_LIMIT_INR=0

# --- WhatsApp (only when you have a public HTTPS host; enable the 'whatsapp' profile)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_ALLOWED_USERS=
WHATSAPP_WEBHOOK_PATH=/webhook
