# Normalise line endings so shell scripts, SQL migrations and Node sources stay LF everywhere.
# Without this, a Windows checkout can silently rewrite a script to CRLF and bash then fails to
# parse constructs such as a brace group followed by `}`.
* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
*.sql   text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
