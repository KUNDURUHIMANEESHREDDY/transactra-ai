NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://transactra:transactra@localhost:5432/transactra
DATABASE_SSL=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional OAuth 2.0 configuration (defaults to API_BASE_URL/api/auth/paypal/callback and localhost:5173)
PAYPAL_REDIRECT_URI=http://127.0.0.1:8787/api/auth/paypal/callback
FRONTEND_URL=http://localhost:5173
# Required: at least 32 random bytes; no fallback or default is permitted.
TOKEN_ENCRYPTION_SECRET=
# CloudPilot shared inference endpoint (preferred when configured).
CLOUDPILOT_INFERENCE_URL=https://cloudpilot-edge.himaneeshreddyk.workers.dev/chat/completions
# Must match the secret configured on cloudpilot-edge; never commit this value.
CLOUDPILOT_INFERENCE_SECRET=
AI_MODEL=stepfun-ai/step-5-preview
# Optional legacy OpenAI-compatible endpoint; used only when CloudPilot is not configured.
AI_BASE_URL=
AI_API_KEY=
# Never expose PAYPAL_CLIENT_SECRET or AI_API_KEY to the browser.
# Telegram bot (create one with @BotFather; find your numeric ID with @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_BOT_USERNAME=
# Public HTTPS URL of the Vite/Cloudflare dashboard. Required for the Telegram Mini App button.
DASHBOARD_URL=https://your-dashboard.example.com
# Dedicated server-only signing key (32+ random bytes); never expose to the browser.
TRANSACTRA_AUTH_HEADER_SECRET=
API_BASE_URL=http://127.0.0.1:8787
TELEGRAM_CLEAR_WEBHOOK=false
# Shared secret used between the Telegram bot / Cloudflare Worker and this API (32+ characters)
BACKEND_SHARED_SECRET=
# Financial Policy Engine limits (per currency, rolling 24-hour window)
FINANCIAL_MAX_TRANSACTION_AMOUNT=1000
FINANCIAL_MAX_DAILY_AMOUNT=2500
FINANCIAL_MAX_DAILY_TRANSACTIONS=10
FINANCIAL_HIGH_VALUE_THRESHOLD=500
# Live payment execution is disabled unless both explicit gates are set.
FINANCIAL_ALLOW_LIVE_PAYMENTS=false
FINANCIAL_LIVE_ACKNOWLEDGEMENT=
