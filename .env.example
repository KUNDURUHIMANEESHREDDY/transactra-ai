NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://transactra:transactra@localhost:5432/transactra
DATABASE_SSL=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# OAuth 2.0 callback and frontend URLs. Production deployments must use HTTPS.
PAYPAL_REDIRECT_URI=http://127.0.0.1:8787/api/auth/paypal/callback
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://127.0.0.1:8787
# Required: generate independent random secrets of at least 32 characters.
TOKEN_ENCRYPTION_SECRET=
AUTH_GATEWAY_SHARED_SECRET=
# Optional OpenAI-compatible endpoint. Blank uses the no-key parser.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Never expose PAYPAL_CLIENT_SECRET or AI_API_KEY to the browser.
# Telegram bot (create one with @BotFather; find your numeric ID with @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CLEAR_WEBHOOK=false
# Shared secret used only between the Cloudflare Worker and this API
BACKEND_SHARED_SECRET=
