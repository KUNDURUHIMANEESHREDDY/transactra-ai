{
    "name":  "transactra-ai",
    "private":  false,
    "version":  "0.1.0",
    "description":  "AI-powered financial operations and transaction orchestration",
    "engines":  {
                    "node":  "\u003e=22.0.0"
                },
    "packageManager":  "pnpm@10.0.0",
    "scripts":  {
                    "build":  "tsc -b",
                    "typecheck":  "tsc -b --pretty false",
                    "test":  "npm run build \u0026\u0026 npm run test:unit",
                    "dev:api":  "npm run build \u0026\u0026 node dist/apps/control-plane/src/server.js",
                    "start:api":  "node dist/apps/control-plane/src/server.js",
                    "db:migrate":  "node --experimental-strip-types apps/control-plane/src/migrate.ts",
                    "db:bootstrap-owner":  "node --experimental-strip-types apps/control-plane/src/bootstrap-owner.ts",
                    "start:worker":  "npm run build \u0026\u0026 node dist/apps/worker/src/main.js",
                    "verify":  "npm test",
                    "test:unit":  "node --test tests/*.test.js",
                    "test:cloudflare-nim":  "node --experimental-sqlite --test infra/cloudflare/tests/*.test.mjs",
                    "start:scheduler":  "npm run build \u0026\u0026 node dist/apps/scheduler/src/main.js",
                    "start:telegram":  "npm run build \u0026\u0026 node dist/apps/telegram/src/main.js",
                    "start:whatsapp":  "npm run build \u0026\u0026 node dist/apps/whatsapp/src/main.js"
                },
    "devDependencies":  {
                            "@types/node":  "^22.13.4",
                            "typescript":  "^5.7.3",
                            "@types/pg":  "^8.11.11",
                            "wrangler":  "4.159.0"
                        },
    "type":  "module",
    "dependencies":  {
                         "pg":  "^8.13.1"
                     },
    "pnpm":  {
                 "onlyBuiltDependencies":  [
                                               "workerd"
                                           ]
             }
}